# NoMAD Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
# PostgreSQL connection string
# Cloud SQL format: postgresql://user:pass@/database?host=/cloudsql/project:region:instance
# Standard format:  postgresql://user:pass@host:port/database

DATABASE_URL=postgresql://nomad-user:<password>@/nomad?host=/cloudsql/<project>:<region>:<instance>

# =============================================================================
# APPLICATION (REQUIRED)
# =============================================================================
# Base URL of your deployed application (for Okta redirect URIs)
BASE_URL=https://nomad.it.prewave.ai

# Server port (default: 8080 for Cloud Run)
PORT=8080

# =============================================================================
# GOOGLE SECRET MANAGER (Cloud Run deployment)
# =============================================================================
# deploy.sh injects these secrets as runtime environment variables.
SECRET_DATABASE_URL=nomad-database-url
SECRET_ATLASSIAN_OAUTH_CLIENT_ID=nomad-atlassian-oauth-client-id
SECRET_ATLASSIAN_OAUTH_CLIENT_SECRET=nomad-atlassian-oauth-client-secret
SECRET_OKTA_CLIENT_ID=nomad-okta-client-id
SECRET_OKTA_CLIENT_SECRET=nomad-okta-client-secret

# =============================================================================
# JIRA API (OAuth 2.0)
# =============================================================================
# Jira integration uses OAuth 2.0 with "NoMAD App" service account
# Changes to Jira tickets will show as "NoMAD App" in history
# For local development, set these directly. For Cloud Run, Secret Manager
# injects them via deploy.sh.
ATLASSIAN_OAUTH_CLIENT_ID=<client-id>
ATLASSIAN_OAUTH_CLIENT_SECRET=<client-secret>

# =============================================================================
# OKTA
# =============================================================================
OKTA_DOMAIN=prewave.okta.com
# For local development, set these directly. For Cloud Run, Secret Manager
# injects them via deploy.sh.
OKTA_CLIENT_ID=<client-id>
OKTA_CLIENT_SECRET=<client-secret>
# ADMIN_GROUP_ID=00gsupqfaclQ4pT1Q417
# ADMIN_GROUP_NAME=Nomad Admins

# =============================================================================
# OKTA APP CONFIGURATION (in Okta Admin Console)
# =============================================================================
# Sign-in redirect URI:  https://nomad.it.prewave.ai/api/auth/callback
# Sign-out redirect URI: https://nomad.it.prewave.ai
# Initiate login URI:    https://nomad.it.prewave.ai/api/auth/login
# Grant type:            Authorization Code
# Scopes:                openid, profile, email, groups